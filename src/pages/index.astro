---
// 根路径：与 x-default 口径统一指向英文版（ADR-002 §3.4，m-3 修复）。
// 静态部署无服务端 Accept-Language；无 JS 一律跳 /en/；有 JS 时 localStorage 偏好优先。
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0; url=/en/" />
    <title>Guangzhou Tianhong Medical Technology Co., Ltd.</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  </head>
  <body>
    <script>
      // 渐进增强：显式语言偏好（localStorage）优先，其余一律 /en/（与 x-default 一致）
      try {
        const stored = localStorage.getItem('thb:lang');
        const target = stored === 'zh' ? '/zh/' : '/en/';
        if (target !== location.pathname) {
          location.replace(target);
        }
      } catch {
        /* 隐私模式等场景忽略，交给 <meta refresh> 兜底 */
      }
    </script>
    <noscript>
      <meta http-equiv="refresh" content="0; url=/en/" />
    </noscript>
  </body>
</html>