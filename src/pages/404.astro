---
import PageLayout from '../components/layout/PageLayout.astro';
import Button from '../components/ui/Button.astro';
import { getLangFromPath, getHomePath } from '../utils/url';
import { getDict } from '../utils/i18n';

// 404（design-spec §6.6）：双语按请求路径语言前缀渲染，默认中文
// 大字号 404（--text-display #D8E7F8）+ 说明 + 返回首页主按钮
// canonical 与语言切换基于首页路径（m-1：/404/ 与 /en/404/ 均不存在）
const lang = getLangFromPath(Astro.url.pathname);
const dict = getDict(lang);
const t = dict.common.common;
---

<PageLayout
  lang={lang}
  dict={dict}
  title={t.not_found_title}
  description={t.not_found_body}
  hreflangLinks={false}
  pathname={getHomePath(lang)}
>
  <section class="notfound u-section">
    <div class="u-container u-text-center">
      <p class="notfound__code">404</p>
      <h1 class="notfound__title">{t.not_found_title}</h1>
      <p class="notfound__body">{t.not_found_body}</p>
      <Button href={getHomePath(lang)} variant="primary">{t.back_home}</Button>
    </div>
  </section>

  <style>
    .notfound {
      display: grid;
      place-items: center;
      text-align: center;
    }

    .notfound__code {
      font-size: var(--text-display);
      font-weight: var(--weight-bold);
      line-height: 1;
      color: var(--color-primary-100);
      margin-bottom: var(--space-xs);
    }

    .notfound__title {
      font-size: var(--text-h2);
      font-weight: var(--weight-medium);
      color: var(--color-neutral-900);
      margin-bottom: var(--space-2xs);
    }

    .notfound__body {
      font-size: var(--text-body);
      color: var(--color-neutral-500);
      margin-bottom: var(--space-lg);
      max-width: var(--measure-zh);
    }
  </style>
</PageLayout>
