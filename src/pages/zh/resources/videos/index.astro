---
import PageLayout from '../../../../components/layout/PageLayout.astro';
import Banner from '../../../../components/layout/Banner.astro';
import EmptyState from '../../../../components/ui/EmptyState.astro';
import SectionHeader from '../../../../components/ui/SectionHeader.astro';
import Button from '../../../../components/ui/Button.astro';
import Icon from '../../../../components/ui/Icon.astro';
import { loadHomeDict } from '../../../../utils/i18n';
import { getVideos } from '../../../../utils/content';
import { assetUrl } from '../../../../utils/assets';
import { getVideosPath, getContactPath } from '../../../../utils/url';
import type { Lang } from '../../../../types/dictionary';
import type { BreadcrumbItem } from '../../../../types/components';

// 视频中心（page-structure §4.2）：全量视频按分类分组 + 每个分类一个入口卡；
// 数据为空 → 空态面板。视频走 assets.ts 唯一出口，原生 <video> preload=none + onerror 兜底。
const lang = 'zh' as Lang;
const dict = loadHomeDict(lang);
const page = dict.resources.videos;
const t = dict.common;
const videos = getVideos(lang);
const items = videos.items;
const catPath = (slug: string) => getVideosPath(lang).replace('/$', '') + `${slug}/`;

const trail: BreadcrumbItem[] = [
  { label: t.breadcrumb.home, href: `/${lang}/` },
  { label: t.nav.resources },
  { label: page.banner.title },
];
---

<PageLayout lang={lang} dict={dict} title={page.banner.title} description={page.banner.subtitle}>
  <Banner
    lang={lang}
    title={page.banner.title}
    subtitle={page.banner.subtitle}
    homeLabel={t.breadcrumb.home}
    ariaLabel={t.breadcrumb.home}
    trail={trail}
  />

  <section class="u-section">
    <div class="u-container">
      {videos.categories.length > 0 && (
        <div class="video-cats">
          {videos.categories.map((c) => (
            <Button href={catPath(c.slug)} variant="secondary">{c.name}</Button>
          ))}
        </div>
      )}
      {items.length > 0 ? (
        <div class="video-groups">
          {videos.categories.map((c) => {
            const group = items.filter((v) => v.categorySlug === c.slug);
            if (group.length === 0) return null;
            return (
              <div class="video-group">
                <SectionHeader title={c.name} />
                <div class="u-card-grid">
                  {group.map((item) => (
                    <div class="video-card card">
                      <div class="video-card__media card__media">
                        <span class="video-card__fallback">
                          <Icon name="play" size={40} />
                          <span class="video-card__fallback-label">{t.common.img_error}</span>
                        </span>
                        <video
                          controls
                          preload="none"
                          playsinline
                          poster={item.poster ? assetUrl(item.poster) : undefined}
                          onerror="this.style.display='none'"
                        >
                          <source src={assetUrl(item.file)} type="video/mp4" />
                        </video>
                      </div>
                      <div class="video-card__body card__body">
                        <h3 class="video-card__title card__title">{item.title}</h3>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            );
          })}
        </div>
      ) : (
        <EmptyState title={page.empty_title} body={page.empty_body} icon="play">
          <Button href={getContactPath(lang)} variant="secondary">{page.empty_cta}</Button>
        </EmptyState>
      )}
    </div>
  </section>
</PageLayout>

<style>
  .video-cats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .video-groups {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .video-card__media {
    position: relative;
    background: var(--color-neutral-100);
  }

  .video-card__media video {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    aspect-ratio: 16 / 9;
  }

  .video-card__fallback {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    background: var(--color-neutral-100);
    color: var(--color-neutral-500);
  }

  .video-card__fallback-label {
    font-size: var(--text-caption);
    color: var(--color-neutral-500);
  }

  .video-card__title {
    font-size: var(--text-h4);
    font-weight: var(--weight-medium);
  }
</style>