---
import PageLayout from '../../../components/layout/PageLayout.astro';
import Banner from '../../../components/layout/Banner.astro';
import EmptyState from '../../../components/ui/EmptyState.astro';
import Icon from '../../../components/ui/Icon.astro';
import { loadHomeDict } from '../../../utils/i18n';
import { getSearchPath } from '../../../utils/url';

// 搜索页（page-structure §0.3）：构建期生成索引 JSON（index.json.ts），
// 客户端按 query 过滤渲染结果；无结果回退空态面板。
// 页内提供可见搜索表单（M-2：用户可在结果页直接改关键词），提交仍走 ?q=
const lang = 'zh';
const dict = loadHomeDict(lang);
const search = dict.common.search;
const t = dict.common;

const trail = [
  { label: t.breadcrumb.home, href: `/${lang}/` },
  { label: search.results_title },
];
---

<PageLayout lang={lang} dict={dict} title={search.results_title} description={search.results_title}>
  <Banner
    lang={lang}
    title={search.results_title}
    homeLabel={t.breadcrumb.home}
    ariaLabel={t.breadcrumb.home}
    trail={trail}
  />

  <section class="u-section">
    <div
      class="u-container"
      data-search-page
      data-lang={lang}
      data-empty-body={search.empty_body}
      data-count-template={search.results_count}
    >
      <form class="search-page-form" action={getSearchPath(lang)} method="get" role="search">
        <input
          class="search-page-form__input"
          type="search"
          name="q"
          placeholder={search.placeholder}
          aria-label={search.aria_label}
        />
        <button class="search-page-form__submit" type="submit" aria-label={search.submit}>
          <Icon name="search" size={20} />
        </button>
      </form>
      <noscript>
        <p class="search-no-js">{search.no_js_hint}</p>
      </noscript>
      <p class="search-count" data-search-count hidden></p>
      <div class="search-results" data-search-results hidden></div>
      <EmptyState title={search.empty_title} icon="search" data-search-empty>
        <span data-empty-body-el></span>
      </EmptyState>
    </div>
  </section>
</PageLayout>

<script>
  import { initSearchPage } from '../../../scripts/search-page';
  initSearchPage();
</script>

<style>
  /* 页内可见搜索表单（M-2） */
  .search-page-form {
    display: flex;
    gap: var(--space-2xs);
    margin-bottom: var(--space-lg);
    max-width: 560px;
  }

  .search-page-form__input {
    flex: 1;
    min-width: 0;
    height: 48px;
    padding: var(--space-xs) var(--space-sm);
    border: var(--border-default);
    border-radius: var(--radius-sm);
    font-size: 16px;
    color: var(--color-neutral-900);
    background: var(--color-white);
  }

  .search-page-form__input::placeholder {
    color: var(--color-neutral-500);
  }

  .search-page-form__input:focus {
    outline: none;
    border-color: var(--color-primary-600);
    box-shadow: 0 0 0 3px var(--color-primary-100);
  }

  .search-page-form__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: var(--radius-sm);
    background: var(--color-primary-600);
    color: var(--color-white);
  }

  .search-page-form__submit:hover {
    background: var(--color-primary-700);
  }

  .search-no-js {
    padding: var(--space-sm);
    margin-bottom: var(--space-md);
    border-radius: var(--radius-sm);
    background: var(--color-warning-50);
    color: var(--color-warning-600);
    font-size: var(--text-small);
    text-align: center;
  }

  .search-count {
    font-size: var(--text-small);
    color: var(--color-neutral-500);
    margin-bottom: var(--space-md);
  }

  .search-results {
    display: grid;
    gap: var(--space-sm);
  }

  .search-result {
    padding: var(--space-md);
    border: var(--border-default);
    border-radius: var(--radius-md);
    background: var(--color-white);
    transition: border-color var(--duration-fast) var(--easing);
  }

  .search-result:hover {
    border-color: var(--color-primary-400);
  }

  .search-result__link {
    display: grid;
    gap: var(--space-3xs);
  }

  .search-result__section {
    font-size: var(--text-caption);
    font-weight: var(--weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary-600);
  }

  .search-result__title {
    font-size: var(--text-body-lg);
    color: var(--color-neutral-900);
  }

  .search-result__desc {
    font-size: var(--text-small);
    color: var(--color-neutral-500);
    line-height: var(--leading-body);
  }
</style>
