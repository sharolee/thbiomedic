---
import PageLayout from '../../../../../components/layout/PageLayout.astro';
import Breadcrumbs from '../../../../../components/layout/Breadcrumbs.astro';
import ProductGrid from '../../../../../components/product/ProductGrid.astro';
import ContactForm from '../../../../../components/ui/ContactForm.astro';
import SectionHeader from '../../../../../components/ui/SectionHeader.astro';
import Icon from '../../../../../components/ui/Icon.astro';
import { assetUrl } from '../../../../../utils/assets';
import { loadHomeDict } from '../../../../../utils/i18n';
import { getProducts, findChildCategory, getContact } from '../../../../../utils/content';
import { getProductsPath, getCategoryPath, getContactPath } from '../../../../../utils/url';
import type { Lang } from '../../../../../types/dictionary';
import type { BreadcrumbItem } from '../../../../../types/components';

// Product detail page (page-structure §3.3 / build-plan §5, English site)
// getStaticPaths is driven by data/products.json: the 12 real product details
// (route prefix comes from product.categorySlug)
export function getStaticPaths() {
  const en = getProducts('en');
  return en.map((product) => ({
    params: { category: product.categorySlug, product: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const lang = 'en' as Lang;
const dict = loadHomeDict(lang);
const page = dict.productDetail;
const t = dict.common;
// categorySlug is a second-level slug; resolve both levels via findChildCategory
// to match the original site's five-level breadcrumb
const parent = findChildCategory(lang, product.categorySlug);
const categoryName = parent?.child.name ?? product.categorySlug;
const related = getProducts(lang).filter((p) => p.categorySlug === product.categorySlug && p.slug !== product.slug);
const image = product.images?.[0];
const contactEmail = getContact(lang)?.email;

const trail: BreadcrumbItem[] = [
  { label: t.breadcrumb.home, href: `/${lang}/` },
  { label: t.nav.products, href: getProductsPath(lang) },
];
if (parent) {
  trail.push({ label: parent.parent.name, href: getCategoryPath(parent.parent.slug, lang) });
  trail.push({ label: parent.child.name, href: getCategoryPath(parent.child.slug, lang) });
} else {
  trail.push({ label: categoryName, href: getCategoryPath(product.categorySlug, lang) });
}
trail.push({ label: product.name });
---

<PageLayout
  lang={lang}
  dict={dict}
  title={`${product.name} - ${dict.productsIndex.meta.title}`}
  description={product.desc ?? page.meta.description}
>
  <section class="u-section">
    <div class="u-container">
      <Breadcrumbs lang={lang} homeLabel={t.breadcrumb.home} ariaLabel={t.breadcrumb.home} trail={trail} />

      <article class="product-detail">
        <div class="product-detail__media" aria-hidden="true">
          <span class="product-detail__placeholder">
            <Icon name="image" size={40} />
            <span class="product-detail__placeholder-label">{t.common.img_error}</span>
          </span>
          {image && (
            <img
              src={assetUrl(image.key)}
              alt={image.alt}
              loading="lazy"
              width={1000}
              height={750}
              onerror="this.style.display='none'"
            />
          )}
        </div>
        <div class="product-detail__body">
          <h1 class="product-detail__title">{product.name}</h1>
          {product.desc && <p class="product-detail__desc">{product.desc}</p>}
        </div>
      </article>

      {related.length > 0 && (
        <div class="product-related">
          <SectionHeader title={t.common.view_all} />
          <ProductGrid
            products={related}
            lang={lang}
            emptyTitle={page.empty_title}
            emptyBody={page.empty_body}
            emptyActionLabel={page.cta}
            emptyActionHref={getContactPath(lang)}
          />
        </div>
      )}

      <div class="inquiry">
        <SectionHeader title={page.inquiry_title} />
        <ContactForm dict={dict} sourceSlug={product.slug} email={contactEmail} />
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .product-detail {
    display: grid;
    gap: var(--space-lg);
    margin-top: var(--space-md);
  }

  @media (min-width: 1024px) {
    .product-detail {
      grid-template-columns: 5fr 7fr;
    }
  }

  .product-detail__media {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-neutral-100);
  }

  .product-detail__media img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-detail__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    color: var(--color-neutral-500);
  }

  .product-detail__placeholder-label {
    font-size: var(--text-caption);
    color: var(--color-neutral-500);
  }

  .product-detail__title {
    font-size: var(--text-h1);
    margin-bottom: var(--space-sm);
  }

  .product-detail__desc {
    font-size: var(--text-body-lg);
    color: var(--color-neutral-700);
  }

  .product-related {
    margin-top: var(--space-xl);
  }

  .inquiry {
    margin-top: var(--space-xl);
    max-width: 760px;
  }
</style>
