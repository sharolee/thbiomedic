---
import PageLayout from '../../components/layout/PageLayout.astro';
import Hero from '../../components/content/Hero.astro';
import TrustBar from '../../components/content/TrustBar.astro';
import BrandLines from '../../components/content/BrandLines.astro';
import StatsBar from '../../components/content/StatsBar.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import { loadHomeDict } from '../../utils/i18n';
import { getNewsItems } from '../../utils/content';
import { assetUrl } from '../../utils/assets';
import { withLangPrefix } from '../../utils/url';

// Home (direction-a-plus structure): video Hero + trust bar + three brand lines +
// stats bar + news (empty state on original site). Block order and layering follow
// the a-plus prototype; no carousel.
const lang = 'en';
const dict = loadHomeDict(lang);
const home = dict.home;
const t = dict.common.common;
const items = getNewsItems(lang);

const trustItems = [
  home.trust_bar.item_1,
  home.trust_bar.item_2,
  home.trust_bar.item_3,
  home.trust_bar.item_4,
  home.trust_bar.item_5,
  home.trust_bar.item_6,
  home.trust_bar.item_7,
];

const brands = [home.brands.card_1, home.brands.card_2, home.brands.card_3];
const stats = [home.stats.item_1, home.stats.item_2, home.stats.item_3, home.stats.item_4];
---

<PageLayout lang={lang} dict={dict} title={home.meta.title} description={home.meta.description}>
  <Hero
    lang={lang}
    eyebrow={home.hero.eyebrow}
    title={home.hero.title}
    lead={home.hero.lead}
    ctaPrimary={home.hero.cta_primary}
    ctaPrimaryHref={home.hero.cta_primary_href}
    ctaSecondary={home.hero.cta_secondary}
    ctaSecondaryHref={home.hero.cta_secondary_href}
    badge={home.hero.badge}
    videoSrc={assetUrl(home.hero.video_key)}
    posterSrc={assetUrl(home.hero.poster_key)}
    ariaLabel={home.hero.eyebrow}
  />

  <TrustBar title={home.trust_bar.title} items={trustItems} />

  <BrandLines
    lang={lang}
    kicker={home.brands.kicker}
    title={home.brands.title}
    subtitle={home.brands.subtitle}
    cards={brands}
    moreLabel={t.view_all}
  />

  <StatsBar kicker={home.stats.kicker} items={stats} />

  <section class="u-section" id="news">
    <div class="u-container">
      <div class="home__news-head">
        <p class="home__kicker">{home.news_section.kicker}</p>
        <div class="home__news-row">
          <h2 class="home__news-title">{home.news_section.title}</h2>
          <a class="home__news-link" href={withLangPrefix('/news/', lang)}>{home.news_section.view_all}</a>
        </div>
      </div>
      {items.length > 0 ? (
        <p class="home__news-empty">{home.news_section.empty_title}</p>
      ) : (
        <EmptyState title={home.news_section.empty_title} body={home.news_section.empty_body} icon="file" />
      )}
    </div>
  </section>
</PageLayout>

<style>
  .home__news-head {
    margin-bottom: var(--space-lg);
  }

  .home__kicker {
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    letter-spacing: 0.1em;
    color: var(--color-primary-600);
    text-transform: uppercase;
    margin-bottom: var(--space-xs);
  }

  .home__news-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .home__news-title {
    font-size: var(--text-h2);
    color: var(--color-neutral-900);
  }

  .home__news-link {
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    color: var(--color-primary-600);
    white-space: nowrap;
  }

  .home__news-link:hover {
    color: var(--color-primary-700);
    text-decoration: underline;
  }
</style>