---
import PageLayout from '../../components/layout/PageLayout.astro';
import { loadHomeDict } from '../../utils/i18n';

const lang = 'en';
const dict = loadHomeDict(lang);

// Home skeleton (W3-1): hero placeholder; full sections built in W3-2
---

<PageLayout
  lang={lang}
  dict={dict}
  title="Guangzhou Tianhong Medical Technology Co., Ltd."
  description="Guangzhou Tianhong Medical Technology Co., Ltd. - Professional medical rehabilitation aids manufacturer"
>
  <section class="hero u-section">
    <div class="u-container u-text-center">
      <h1 class="hero__title">{dict.home.hero.title}</h1>
      <p class="hero__subtitle">{dict.home.hero.subtitle}</p>
      <a href="/en/products/" class="btn btn-primary">{dict.home.hero.cta}</a>
    </div>
  </section>

  <style>
    .hero {
      display: grid;
      place-items: center;
      text-align: center;
    }

    .hero__title {
      font-size: var(--text-display);
      line-height: var(--leading-display);
      font-weight: var(--weight-bold);
      color: var(--color-neutral-900);
      margin-bottom: var(--space-sm);
    }

    .hero__subtitle {
      font-size: var(--text-body-lg);
      line-height: var(--leading-body);
      color: var(--color-neutral-700);
      margin-bottom: var(--space-lg);
      max-width: var(--measure-en);
    }
  </style>
</PageLayout>
