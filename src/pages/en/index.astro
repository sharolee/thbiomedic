---
import PageLayout from '../../components/layout/PageLayout.astro';
import Hero from '../../components/content/Hero.astro';
import TrustBar from '../../components/content/TrustBar.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import CategoryGrid from '../../components/product/CategoryGrid.astro';
import PromoVideo from '../../components/content/PromoVideo.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import { loadHomeDict } from '../../utils/i18n';
import { getCategories } from '../../utils/content';
import { getProductsPath, getContactPath } from '../../utils/url';

// Home (page-structure §1, English site)
const lang = 'en';
const dict = loadHomeDict(lang);
const home = dict.home;
const categories = getCategories(lang);

const heroSlides = [home.hero.slide_1, home.hero.slide_2, home.hero.slide_3];
const trustItems = [
  home.trust_bar.item_1, home.trust_bar.item_2, home.trust_bar.item_3,
  home.trust_bar.item_4, home.trust_bar.item_5, home.trust_bar.item_6,
  home.trust_bar.item_7,
];
---

<PageLayout lang={lang} dict={dict} title={home.meta.title} description={home.meta.description}>
  <Hero
    lang={lang}
    slides={heroSlides}
    ariaLabel={home.hero.aria_label}
    slideLabel={home.hero.slide_label}
  />

  <TrustBar title={home.trust_bar.title} items={trustItems} />

  <!-- Product entries (page-structure §1-3) -->
  <section class="u-section home-section">
    <div class="u-container">
      <SectionHeader
        title={home.product_entries.title}
        subtitle={home.product_entries.subtitle}
        linkHref={getProductsPath(lang)}
        linkLabel={home.product_entries.view_all}
      />
      <CategoryGrid
        categories={categories}
        lang={lang}
        comingSoonLabel={home.product_entries.coming_soon}
        emptyTitle={home.product_entries.empty_title}
        emptyBody={home.product_entries.empty_body}
        emptyActionLabel={home.product_entries.cta}
        emptyActionHref={getContactPath(lang)}
      />
    </div>
  </section>

  <!-- About summary (page-structure §1-4) -->
  <section class="u-section home-section home-section--alt">
    <div class="u-container about-summary">
      <div class="about-summary__media" aria-hidden="true">
        <span class="about-summary__media-icon"><Icon name="image" size={40} /></span>
      </div>
      <div class="about-summary__text">
        <h2 class="about-summary__title">{home.about_summary.title}</h2>
        <p class="about-summary__body">{home.about_summary.body}</p>
        <Button href={`/${lang}/about/`} variant="secondary" icon="arrow-right">
          {home.about_summary.cta}
        </Button>
      </div>
    </div>
  </section>

  <!-- Corporate video (page-structure §1-5) -->
  <PromoVideo
    title={home.promo_video.title}
    subtitle={home.promo_video.subtitle}
    placeholder={home.promo_video.placeholder}
    playLabel={home.promo_video.play_label}
  />

  <!-- Contact CTA (page-structure §1-7) -->
  <section class="home-section contact-cta">
    <div class="u-container contact-cta__inner">
      <div class="contact-cta__text">
        <h2 class="contact-cta__title">{home.contact_cta.title}</h2>
        <p class="contact-cta__body">{home.contact_cta.body}</p>
      </div>
      <Button href={getContactPath(lang)} variant="primary">{home.contact_cta.cta}</Button>
    </div>
  </section>
</PageLayout>

<style>
  .home-section {
    background: var(--color-white);
  }

  .home-section--alt {
    background: var(--color-neutral-100);
  }

  .about-summary {
    display: grid;
    gap: var(--space-lg);
  }

  @media (min-width: 1024px) {
    .about-summary {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
  }

  .about-summary__media {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    background: var(--color-neutral-200);
  }

  .about-summary__media-icon {
    display: grid;
    place-items: center;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--color-white);
    color: var(--color-neutral-500);
  }

  .about-summary__title {
    font-size: var(--text-h2);
    margin-bottom: var(--space-sm);
  }

  .about-summary__body {
    font-size: var(--text-body);
    color: var(--color-neutral-700);
    margin-bottom: var(--space-lg);
    max-width: var(--measure-en);
  }

  .contact-cta {
    background: var(--color-accent-100);
  }

  .contact-cta__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: var(--space-xl);
  }

  .contact-cta__title {
    font-size: var(--text-h3);
    color: var(--color-neutral-900);
  }

  .contact-cta__body {
    margin-top: var(--space-2xs);
    color: var(--color-neutral-700);
  }
</style>
