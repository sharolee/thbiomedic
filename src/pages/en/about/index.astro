---
import PageLayout from '../../../components/layout/PageLayout.astro';
import Banner from '../../../components/layout/Banner.astro';
import Button from '../../../components/ui/Button.astro';
import Icon from '../../../components/ui/Icon.astro';
import { loadHomeDict } from '../../../utils/i18n';
import { getCertificates } from '../../../utils/content';
import { getContactPath } from '../../../utils/url';
import { assetUrl } from '../../../utils/assets';
import type { BreadcrumbItem } from '../../../types/components';

// About Us (direction-a-plus layout): Banner + company overview (two-column
// text/image) + development history (wide image) + honors (certificate grid).
const lang = 'en';
const dict = loadHomeDict(lang);
const page = dict.about;
const t = dict.common;
const certs = getCertificates(lang);

const trail: BreadcrumbItem[] = [
  { label: t.breadcrumb.home, href: `/${lang}/` },
  { label: page.banner.title },
];
---

<PageLayout lang={lang} dict={dict} title={page.meta.title} description={page.meta.description}>
  <Banner
    lang={lang}
    title={page.banner.title}
    subtitle={page.banner.subtitle}
    homeLabel={t.breadcrumb.home}
    ariaLabel={t.breadcrumb.home}
    trail={trail}
  />

  <section class="u-section">
    <div class="u-container">
      <div class="about__profile">
        <div class="about__text">
          <h2 class="about__h2">{page.profile.title}</h2>
          <h3 class="about__company">{page.profile.company_name}</h3>
          <p class="about__para">{page.profile.para_1}</p>
          <p class="about__para">{page.profile.para_2}</p>
          <p class="about__para">{page.profile.para_3}</p>
        </div>
        <figure class="about__figure">
          <span class="about__figure-fallback">
            <Icon name="image" size={40} />
            <span class="about__figure-fallback-label">{t.common.img_error}</span>
          </span>
          <img
            src={assetUrl(page.profile.image_src)}
            alt={page.profile.image_alt}
            loading="lazy"
            width={1200}
            height={675}
            onerror="this.style.display='none'"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="u-section about__history-sec">
    <div class="u-container">
      <h2 class="about__h2">{page.history.title}</h2>
      <figure class="about__history-figure">
        <span class="about__figure-fallback">
          <Icon name="image" size={40} />
          <span class="about__figure-fallback-label">{t.common.img_error}</span>
        </span>
        <img
          src={assetUrl(page.history.image_src)}
          alt={page.history.image_alt}
          loading="lazy"
          width={1600}
          height={900}
          onerror="this.style.display='none'"
        />
      </figure>
    </div>
  </section>

  <section class="u-section" id="certificates">
    <div class="u-container">
      <div class="about__cert-head">
        <p class="about__kicker">{t.nav.products_all}</p>
        <h2 class="about__h2">{page.certificates_intro.title}</h2>
      </div>
      <div class="u-card-grid about__cert-grid">
        {certs.map((cert) => (
          <figure class="about__cert card">
            <div class="about__cert-media">
              <span class="about__figure-fallback">
                <Icon name="image" size={40} />
                <span class="about__figure-fallback-label">{t.common.img_error}</span>
              </span>
              <img
                class="about__cert-img"
                src={assetUrl(cert.image.key)}
                alt={cert.image.alt}
                loading="lazy"
                width={600}
                height={450}
                onerror="this.style.display='none'"
              />
            </div>
            <figcaption class="about__cert-title">{cert.title}</figcaption>
          </figure>
        ))}
      </div>
      <div class="about__cta">
        <Button href={getContactPath(lang)} variant="secondary">{page.cta}</Button>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .about__profile {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 1024px) {
    .about__profile {
      grid-template-columns: 7fr 5fr;
      align-items: start;
    }
  }

  .about__kicker {
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    letter-spacing: 0.1em;
    color: var(--color-primary-600);
    text-transform: uppercase;
    margin-bottom: var(--space-xs);
  }

  .about__kicker--alt {
    color: var(--color-primary-700);
  }

  .about__h2 {
    font-size: var(--text-h2);
    color: var(--color-neutral-900);
    margin-bottom: var(--space-sm);
  }

  .about__company {
    font-size: var(--text-h3);
    color: var(--color-neutral-900);
    font-weight: var(--weight-medium);
    margin-bottom: var(--space-sm);
  }

  .about__para {
    color: var(--color-neutral-700);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    margin-bottom: var(--space-sm);
    max-width: var(--measure-en);
  }

  .about__figure,
  .about__history-figure {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-lg);
    margin-top: var(--space-md);
  }

  .about__figure img,
  .about__history-figure img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    background: var(--color-neutral-100);
  }

  /* Image load fallback: placeholder + error hint (ADR-003 §5.2 rule 4) */
  .about__figure-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    background: var(--color-neutral-100);
    color: var(--color-neutral-500);
  }

  .about__figure-fallback-label {
    font-size: var(--text-caption);
    color: var(--color-neutral-500);
  }

  .about__cert-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-neutral-100);
  }

  .about__cert-img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .about__cert-grid {
    margin-bottom: var(--space-lg);
  }

  .about__cert {
    overflow: hidden;
    text-align: center;
  }

  .about__cert-media .about__figure-fallback {
    background: var(--color-neutral-100);
  }

  .about__cert-title {
    padding: var(--space-sm);
    font-size: var(--text-small);
    color: var(--color-neutral-700);
  }

  .about__cta {
    text-align: center;
    margin-top: var(--space-lg);
  }
</style>
