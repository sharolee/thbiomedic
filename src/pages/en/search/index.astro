---
import PageLayout from '../../../components/layout/PageLayout.astro';
import Banner from '../../../components/layout/Banner.astro';
import EmptyState from '../../../components/ui/EmptyState.astro';
import { loadHomeDict } from '../../../utils/i18n';

// Search page (page-structure §0.3, skeleton: search index generated by W3-3)
const lang = 'en';
const dict = loadHomeDict(lang);
const search = dict.common.search;
const t = dict.common;

const trail = [
  { label: t.breadcrumb.home, href: `/${lang}/` },
  { label: search.results_title },
];
---

<PageLayout lang={lang} dict={dict} title={search.results_title} description={search.results_title}>
  <Banner
    lang={lang}
    title={search.results_title}
    homeLabel={t.breadcrumb.home}
    ariaLabel={t.breadcrumb.home}
    trail={trail}
  />

  <section class="u-section">
    <div class="u-container" data-search-page data-empty-body={search.empty_body}>
      <noscript>
        <p class="search-no-js">{search.no_js_hint}</p>
      </noscript>
      <EmptyState title={search.empty_title} icon="search" />
    </div>
  </section>
</PageLayout>

<script>
  // Skeleton: reads the URL query and shows the empty-state hint; once the
  // search index (W3-3) is generated, filter it client-side and render results
  const root = document.querySelector<HTMLElement>('[data-search-page]');
  if (root) {
    const query = new URLSearchParams(window.location.search).get('q');
    const template = root.dataset.emptyBody ?? '';
    if (query) {
      const hint = document.createElement('p');
      hint.className = 'search-no-js';
      hint.textContent = template.replace('{query}', query);
      root.insertBefore(hint, root.firstChild);
    }
  }
</script>

<style>
  .search-no-js {
    padding: var(--space-sm);
    margin-bottom: var(--space-md);
    border-radius: var(--radius-sm);
    background: var(--color-warning-50);
    color: var(--color-warning-600);
    font-size: var(--text-small);
    text-align: center;
  }
</style>
