---
import PageLayout from '../../../components/layout/PageLayout.astro';
import Banner from '../../../components/layout/Banner.astro';
import ContactForm from '../../../components/ui/ContactForm.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import { loadHomeDict } from '../../../utils/i18n';
import { getContact } from '../../../utils/content';
import { localAsset } from '../../../utils/assets';
import Icon from '../../../components/ui/Icon.astro';

// Contact Us (page-structure §6)
// Contact info cards read from data/contact.json (W3-3 fills; empty → form only)
const lang = 'en';
const dict = loadHomeDict(lang);
const page = dict.contact;
const t = dict.common;
const contact = getContact(lang);

// tel: href normalization: "+86 020-82350336" -> "tel:+862082350336"
// Extension (en has -2018): "+86 020-82350336-2018" -> "tel:+8620823503362018" (m-3)
const normalizeTel = (raw: string) =>
  'tel:' + raw.replace(/[^\d+]/g, '').replace(/^\+860(?=\d)/, '+86');

const telHref = contact ? normalizeTel(contact.phone) : undefined;
const telExtHref = contact?.phoneExt ? normalizeTel(contact.phoneExt) : undefined;

const trail = [
  { label: t.breadcrumb.home, href: `/${lang}/` },
  { label: page.banner.title },
];
---

<PageLayout lang={lang} dict={dict} title={page.meta.title} description={page.meta.description}>
  <Banner
    lang={lang}
    title={page.banner.title}
    subtitle={page.banner.subtitle}
    homeLabel={t.breadcrumb.home}
    ariaLabel={t.breadcrumb.home}
    trail={trail}
  />

  <section class="u-section">
    <div class="u-container">
      {contact && (
        <div class="contact-info">
          <SectionHeader title={page.info_intro} />
          <div class="contact-info__grid">
            <div class="contact-info__card">
              <Icon name="phone" size={24} />
              <h3 class="contact-info__label">{t.form.phone}</h3>
              <a class="contact-info__value" href={telHref}>{contact.phone}</a>
              {contact.phoneExt && <a class="contact-info__ext" href={telExtHref}>{contact.phoneExt}</a>}
            </div>
            <div class="contact-info__card">
              <Icon name="mail" size={24} />
              <h3 class="contact-info__label">{t.form.email}</h3>
              <a class="contact-info__value" href={`mailto:${contact.email}`}>{contact.email}</a>
            </div>
            <div class="contact-info__card">
              <Icon name="map-pin" size={24} />
              <h3 class="contact-info__label">{page.address_label}</h3>
              <p class="contact-info__value">{contact.address}</p>
            </div>
            {contact.wechatQr && (
              <div class="contact-info__card">
                <img class="contact-info__qr" src={localAsset('wechat-qr')} alt={contact.wechatQr.alt} loading="lazy" onerror="this.closest('.contact-info__card').hidden = true" />
                <p class="contact-info__value">{contact.wechatQr.alt}</p>
              </div>
            )}
          </div>
        </div>
      )}

      <div class="contact-form-section">
        <SectionHeader title={page.form_intro} />
        <ContactForm dict={dict} email={contact?.email} />
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .contact-info {
    margin-bottom: var(--space-xl);
  }

  .contact-info__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  @media (min-width: 768px) {
    .contact-info__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .contact-info__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-md);
    border: var(--border-default);
    border-radius: var(--radius-md);
    background: var(--color-white);
  }

  .contact-info__card svg {
    color: var(--color-primary-600);
  }

  .contact-info__label {
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    color: var(--color-neutral-500);
  }

  .contact-info__value {
    font-size: var(--text-body);
    color: var(--color-neutral-900);
  }

  a.contact-info__value:hover {
    color: var(--color-primary-600);
    text-decoration: underline;
  }

  .contact-info__ext {
    font-size: var(--text-small);
    color: var(--color-neutral-500);
  }

  a.contact-info__ext:hover {
    color: var(--color-primary-600);
    text-decoration: underline;
  }

  .contact-info__qr {
    width: 96px;
    border-radius: var(--radius-md);
  }

  .contact-form-section {
    max-width: 760px;
  }
</style>
