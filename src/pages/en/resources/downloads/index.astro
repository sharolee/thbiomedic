---
import PageLayout from '../../../../components/layout/PageLayout.astro';
import Banner from '../../../../components/layout/Banner.astro';
import EmptyState from '../../../../components/ui/EmptyState.astro';
import { loadHomeDict } from '../../../../utils/i18n';
import { getDownloads } from '../../../../utils/content';
import { assetUrl } from '../../../../utils/assets';
import type { BreadcrumbItem } from '../../../../types/components';

// Downloads (direction-a-plus layout): Banner + download card list (PDF direct
// links via assets.ts, ADR-003).
const lang = 'en';
const dict = loadHomeDict(lang);
const page = dict.resources.downloads;
const t = dict.common;
const downloads = getDownloads(lang);

const trail: BreadcrumbItem[] = [
  { label: t.breadcrumb.home, href: `/${lang}/` },
  { label: t.nav.resources },
  { label: page.banner.title },
];
---

<PageLayout lang={lang} dict={dict} title={page.banner.title} description={page.banner.subtitle}>
  <Banner
    lang={lang}
    title={page.banner.title}
    subtitle={page.banner.subtitle}
    homeLabel={t.breadcrumb.home}
    ariaLabel={t.breadcrumb.home}
    trail={trail}
  />

  <section class="u-section">
    <div class="u-container">
      {downloads.length > 0 ? (
        <div class="downloads">
          <p class="downloads__kicker">{t.nav.resources_downloads}</p>
          <h2 class="downloads__title">{page.banner.title}</h2>
          <ul class="downloads__list">
            {downloads.map((item) => (
              <li>
                <a class="download-card card" href={assetUrl(item.file)} download target="_blank" rel="noopener">
                  <span class="download-card__icon" aria-hidden="true">PDF</span>
                  <span class="download-card__meta">
                    <span class="download-card__title">{item.title}</span>
                    <span class="download-card__file">{item.size}</span>
                  </span>
                  <span class="download-card__arrow" aria-hidden="true">↓</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ) : (
        <EmptyState title={page.empty_title} body={page.empty_body} icon="download" />
      )}
    </div>
  </section>
</PageLayout>

<style>
  .downloads__kicker {
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    letter-spacing: 0.1em;
    color: var(--color-primary-600);
    text-transform: uppercase;
    margin-bottom: var(--space-xs);
  }

  .downloads__title {
    font-size: var(--text-h2);
    color: var(--color-neutral-900);
    margin-bottom: var(--space-lg);
  }

  .downloads__list {
    display: grid;
    gap: var(--space-sm);
    max-width: 760px;
  }

  .download-card {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md);
    text-decoration: none;
  }

  .download-card__icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-sm);
    background: var(--color-primary-100);
    color: var(--color-primary-700);
    display: grid;
    place-items: center;
    font-size: var(--text-small);
    font-weight: var(--weight-bold);
    letter-spacing: 0.05em;
  }

  .download-card__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    flex: 1;
    min-width: 0;
  }

  .download-card__title {
    font-size: var(--text-body-lg);
    font-weight: var(--weight-medium);
    color: var(--color-neutral-900);
  }

  .download-card__file {
    font-size: var(--text-small);
    color: var(--color-neutral-500);
  }

  .download-card__arrow {
    flex-shrink: 0;
    color: var(--color-primary-600);
    font-size: var(--text-h4);
  }
</style>