---
import type { BrandLinesProps } from '../../types/components';
import { withLangPrefix } from '../../utils/url';

type Props = BrandLinesProps;

// 三大品牌线（direction-a-plus §.products）：kicker + h2 + 导语 + 三张品牌卡。
// 卡图区为品牌缩写渐变底（克制不喧宾），卡体：注册品牌 + 标题 + 摘要 + 查看系列。
const { lang, kicker, title, subtitle, cards, moreLabel } = Astro.props;
---

<section class="brands u-section">
  <div class="u-container">
    <div class="brands__head reveal">
      <p class="brands__kicker">{kicker}</p>
      <h2 class="brands__title">{title}</h2>
      <p class="brands__subtitle">{subtitle}</p>
    </div>
    <div class="u-card-grid">
      {cards.map((card, i) => (
        <article class:list={{ 'p-card': true, 'reveal': true }} data-delay={i > 0 ? String(i) : undefined}>
          <div class="p-card__thumb">{card.mark}</div>
          <div class="p-card__body">
            <p class="p-card__reg">{card.brand}</p>
            <h3 class="p-card__title">{card.title}</h3>
            <p class="p-card__desc">{card.desc}</p>
            <a class="p-card__more" href={withLangPrefix(card.href, lang)}>
              <span>{moreLabel}</span>
              <span aria-hidden="true"> →</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .brands__head {
    max-width: 44em;
    margin-bottom: var(--space-xl);
  }

  .brands__kicker {
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    letter-spacing: 0.1em;
    color: var(--color-primary-600);
    text-transform: uppercase;
    margin-bottom: var(--space-xs);
  }

  .brands__title {
    font-size: var(--text-h2);
    color: var(--color-neutral-900);
    margin-bottom: var(--space-sm);
  }

  .brands__subtitle {
    color: var(--color-neutral-500);
    font-size: var(--text-body-lg);
  }

  .p-card {
    background: var(--color-white);
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform var(--duration-base) var(--easing), box-shadow var(--duration-base) var(--easing);
  }

  .p-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .p-card__thumb {
    aspect-ratio: 16 / 9;
    background: linear-gradient(135deg, var(--color-primary-100), var(--color-primary-50));
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary-700);
    font-weight: var(--weight-bold);
    letter-spacing: 0.06em;
    font-size: var(--text-h2);
  }

  .p-card:nth-child(2) .p-card__thumb {
    background: linear-gradient(135deg, var(--color-primary-50), var(--color-neutral-100));
  }

  .p-card:nth-child(3) .p-card__thumb {
    background: linear-gradient(135deg, var(--color-accent-100), #fff7f1);
    color: var(--color-accent-500);
  }

  .p-card__body {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    flex: 1;
  }

  .p-card__reg {
    font-size: var(--text-small);
    color: var(--color-primary-600);
    font-weight: var(--weight-medium);
  }

  .p-card__title {
    font-size: var(--text-h3);
    color: var(--color-neutral-900);
  }

  .p-card__desc {
    color: var(--color-neutral-500);
    font-size: var(--text-body);
    flex: 1;
  }

  .p-card__more {
    font-size: var(--text-body);
    font-weight: var(--weight-medium);
    color: var(--color-primary-600);
  }

  .p-card__more:hover {
    color: var(--color-primary-700);
    text-decoration: underline;
  }

  .reveal {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.7s var(--easing), transform 0.7s var(--easing);
  }

  .reveal.in {
    opacity: 1;
    transform: none;
  }

  .reveal[data-delay='1'] {
    transition-delay: 0.12s;
  }

  .reveal[data-delay='2'] {
    transition-delay: 0.24s;
  }

  .no-js .reveal,
  .reduced-motion .reveal {
    opacity: 1;
    transform: none;
    transition: none;
  }
</style>