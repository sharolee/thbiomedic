---
import type { HeroProps } from '../../types/components';
import { withLangPrefix } from '../../utils/url';

type Props = HeroProps;

// 首页视频 Hero（direction-a-plus §.hero）：视频背景 + 浅色罩层 + 轻粒子 canvas
// + 眉标/主标题/导语/双 CTA + live 徽标。滚动显现与粒子由 effects.ts 驱动；
// 无 JS 降级：poster 底图常显（scrim 保可读性），无 autoplay 依赖。
const { lang, eyebrow, title, lead, ctaPrimary, ctaPrimaryHref, ctaSecondary, ctaSecondaryHref, badge, videoSrc, posterSrc, ariaLabel } = Astro.props;
---

<section class="hero" aria-label={ariaLabel}>
  <div class="hero-media" aria-hidden="true">
    <video autoplay muted loop playsinline preload="none" poster={posterSrc} onerror="this.style.display='none'">
      <source src={videoSrc} type="video/mp4" />
    </video>
  </div>
  <div class="hero-scrim" aria-hidden="true"></div>
  <canvas id="hero-particles" class="hero-particles" aria-hidden="true"></canvas>
  <div class="hero__inner u-container">
    <p class="hero__eyebrow reveal">{eyebrow}</p>
    <h1 class="hero__title reveal" data-delay="1">{title}</h1>
    <p class="hero__lead reveal" data-delay="2">{lead}</p>
    <div class="hero__actions reveal" data-delay="2">
      <a class="btn btn-primary" href={withLangPrefix(ctaPrimaryHref, lang)}>{ctaPrimary}</a>
      <a class="btn btn-outline" href={withLangPrefix(ctaSecondaryHref, lang)}>{ctaSecondary}</a>
    </div>
    <span class="hero__badge reveal" data-delay="2"><i class="hero__live" aria-hidden="true"></i>{badge}</span>
  </div>
</section>

<script>
  import { initAplusEffects } from '../../scripts/effects';
  initAplusEffects();
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: min(88vh, 760px);
    display: flex;
    align-items: center;
    padding: var(--space-3xl) 0;
    background: var(--color-primary-50);
  }

  .hero-media,
  .hero-media video,
  .hero-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-media video {
    z-index: 0;
  }

  /* 浅色可读性罩层：保持克制浅调，又压住视频 */
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      100deg,
      rgba(239, 248, 251, 0.96) 0%,
      rgba(239, 248, 251, 0.88) 42%,
      rgba(214, 238, 245, 0.62) 100%
    );
  }

  .hero-particles {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    z-index: 3;
    width: 100%;
  }

  .hero__eyebrow {
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    letter-spacing: 0.12em;
    color: var(--color-primary-700);
    text-transform: uppercase;
    margin-bottom: var(--space-sm);
  }

  .hero__title {
    font-size: var(--text-display);
    line-height: var(--leading-display);
    color: var(--color-neutral-900);
    margin-bottom: var(--space-md);
    max-width: 14em;
  }

  .hero__lead {
    font-size: var(--text-body-lg);
    color: var(--color-neutral-700);
    max-width: 34em;
    margin-bottom: var(--space-lg);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-top: var(--space-xl);
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.75);
    border: 1px solid var(--color-primary-100);
    font-size: var(--text-small);
    color: var(--color-primary-700);
    font-weight: var(--weight-medium);
    backdrop-filter: blur(6px);
  }

  .hero__live {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent-500);
    animation: hero-pulse 2s infinite;
  }

  @keyframes hero-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  /* 滚动显现（effects.ts 驱动，无 JS 直接显示） */
  .reveal {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.7s var(--easing), transform 0.7s var(--easing);
  }

  .reveal.in {
    opacity: 1;
    transform: none;
  }

  .reveal[data-delay='1'] {
    transition-delay: 0.12s;
  }

  .reveal[data-delay='2'] {
    transition-delay: 0.24s;
  }

  .no-js .reveal,
  .reduced-motion .reveal {
    opacity: 1;
    transform: none;
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__live {
      animation: none;
    }
  }
</style>