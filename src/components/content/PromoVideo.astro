---
import type { PromoVideoProps } from '../../types/components';
import Icon from '../ui/Icon.astro';

type Props = PromoVideoProps;

// 公司宣传视频区（page-structure §1-5 / design-spec §6.6）：
// 深底 #0B2B52 区块 + 16:9 播放器（最大 960px 居中）
// 视频素材缺失 → 播放器占位（海报图保留 + 内嵌提示）
// W3-3 迁移素材后传入 videoSrc 即渲染原生 <video>
const { title, subtitle, placeholder, playLabel, videoSrc } = Astro.props;
---

<section class="promo-video">
  <div class="u-container">
    <h2 class="promo-video__title">{title}</h2>
    <p class="promo-video__subtitle">{subtitle}</p>
    <div class="promo-video__player">
      {videoSrc ? (
        <video controls preload="metadata" poster="" aria-label={playLabel}>
          <source src={videoSrc} type="video/mp4" />
          <p>{placeholder}</p>
        </video>
      ) : (
        <div class="promo-video__placeholder">
          <span class="promo-video__play-icon" aria-hidden="true"><Icon name="play" size={40} /></span>
          <p class="promo-video__hint">{placeholder}</p>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .promo-video {
    background: var(--color-primary-900);
    color: var(--color-white);
    padding-block: var(--space-2xl);
  }

  @media (min-width: 1024px) {
    .promo-video {
      padding-block: var(--space-3xl);
    }
  }

  .promo-video__title {
    text-align: center;
    font-size: var(--text-h2);
    color: var(--color-white);
  }

  .promo-video__subtitle {
    text-align: center;
    margin-top: var(--space-2xs);
    margin-bottom: var(--space-lg);
    font-size: var(--text-body);
    color: rgba(255, 255, 255, 0.7);
  }

  .promo-video__player {
    max-width: 960px;
    margin-inline: auto;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: rgba(255, 255, 255, 0.06);
  }

  .promo-video__player video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .promo-video__placeholder {
    display: grid;
    place-items: center;
    align-content: center;
    gap: var(--space-sm);
    width: 100%;
    height: 100%;
    border: 1px dashed rgba(255, 255, 255, 0.25);
  }

  .promo-video__play-icon {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    color: var(--color-white);
  }

  .promo-video__hint {
    font-size: var(--text-small);
    color: rgba(255, 255, 255, 0.6);
  }
</style>
