---
import type { BannerProps } from '../../types/components';
import Breadcrumbs from './Breadcrumbs.astro';

type Props = BannerProps;

// 页横幅（page-structure §0.1 / design-spec §6.7）：背景图或品牌渐变底 +
// H1 + 面包屑（内页专用，首页不用本组件）
const { lang, title, subtitle, homeLabel, ariaLabel, trail, image } = Astro.props;
---

<section class="banner" data-banner>
  {image && <img class="banner__bg" src={image} alt="" aria-hidden="true" loading="eager" />}
  <div class="banner__overlay" aria-hidden="true"></div>
  <div class="banner__inner u-container">
    <Breadcrumbs lang={lang} homeLabel={homeLabel} ariaLabel={ariaLabel} trail={trail} />
    <h1 class="banner__title">{title}</h1>
    {subtitle && <p class="banner__subtitle">{subtitle}</p>}
  </div>
</section>

<style>
  .banner {
    position: relative;
    overflow: hidden;
    background: linear-gradient(120deg, var(--color-primary-900) 0%, var(--color-primary-700) 100%);
    color: var(--color-white);
  }

  .banner__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .banner__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, rgba(11, 43, 82, 0.88) 0%, rgba(11, 43, 82, 0.55) 100%);
  }

  .banner__inner {
    position: relative;
    padding-block: var(--space-xl) var(--space-lg);
  }

  @media (min-width: 1024px) {
    .banner__inner {
      padding-block: var(--space-2xl) var(--space-xl);
    }
  }

  .banner__title {
    margin-top: var(--space-sm);
    font-size: var(--text-h1);
    color: var(--color-white);
  }

  .banner__subtitle {
    margin-top: var(--space-2xs);
    font-size: var(--text-body-lg);
    color: rgba(255, 255, 255, 0.85);
    max-width: var(--measure-zh);
  }

  /* 深底上的面包屑配色 */
  .banner :global(.breadcrumbs__link) {
    color: rgba(255, 255, 255, 0.9);
  }

  .banner :global(.breadcrumbs__link:hover) {
    color: var(--color-white);
  }

  .banner :global(.breadcrumbs__sep) {
    color: rgba(255, 255, 255, 0.4);
  }

  .banner :global(.breadcrumbs__current) {
    color: rgba(255, 255, 255, 0.7);
  }
</style>
