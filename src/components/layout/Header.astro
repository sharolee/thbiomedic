---
import type { HeaderProps } from '../../types/components';
import LanguageSwitcher from '../ui/LanguageSwitcher.astro';
import Icon from '../ui/Icon.astro';
import { getHomePath, getProductsPath, getDownloadsPath, getVideosPath, getSearchPath, getCategoryPath } from '../../utils/url';
import { localAsset } from '../../utils/assets';
import { getCategories } from '../../utils/content';

type Props = HeaderProps;

// 页头（design-spec §6.2）：桌面 72px sticky / 移动 56px；抽屉导航 +
// 搜索图标（滑出搜索条）+ 产品中心/资源下拉
const { lang, pathname, dict } = Astro.props;
const t = dict.common;
const categories = getCategories(lang);
const navItems = [
  { href: `/${lang}/`, label: t.nav.home },
  { href: `/${lang}/about/`, label: t.nav.about },
  {
    href: getProductsPath(lang),
    label: t.nav.products,
    children: [
      { href: getProductsPath(lang), label: t.nav.products_all },
      ...categories.map((c) => ({ href: getCategoryPath(c.slug, lang), label: c.name })),
    ],
  },
  {
    href: `/${lang}/resources/`,
    label: t.nav.resources,
    children: [
      { href: getDownloadsPath(lang), label: t.nav.resources_downloads },
      { href: getVideosPath(lang), label: t.nav.resources_videos },
    ],
  },
  { href: `/${lang}/news/`, label: t.nav.news },
  { href: `/${lang}/contact/`, label: t.nav.contact },
];
const normalize = (p: string) => p.replace(/\/+$/, '');
const current = normalize(pathname);
const isActive = (href: string) => href === `/${lang}/` ? current === `/${lang}` : current.startsWith(href.replace(/\/+$/, ''));
const search = dict.common.search;
---

<header class="header" data-header>
  <div class="header__bar u-container">
    <a class="header__logo" href={getHomePath(lang)}>
      <img
        class="header__logo-img"
        src={localAsset('logo')}
        alt={t.footer.brand}
        width={188}
        height={54}
      />
    </a>

    <nav class="header__nav" aria-label={t.nav.aria_label}>
      <ul class="header__nav-list">
        {navItems.map((item) => (
          <li class:list={{ 'has-dropdown': !!item.children }}>
            <a
              class:list={{ 'header__nav-link': true, 'is-active': isActive(item.href) }}
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
              {item.children && <Icon name="chevron-down" size={16} />}
            </a>
            {item.children && (
              <ul class="header__dropdown">
                {item.children.map((child) => (
                  <li>
                    <a href={child.href}>{child.label}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="header__actions">
      <div class="search" data-search>
        <a class="search__toggle" href={getSearchPath(lang)} data-search-toggle aria-label={search.open_label}>
          <Icon name="search" size={20} />
        </a>
        <div class="search__bar" data-search-bar hidden>
          <form class="search__form" action={getSearchPath(lang)} method="get" role="search">
            <input
              class="search__input"
              type="search"
              name="q"
              placeholder={search.placeholder}
              aria-label={search.aria_label}
              data-search-input
            />
            <button class="search__submit" type="submit" aria-label={search.submit}>
              <Icon name="search" size={20} />
            </button>
            <button class="search__close" type="button" data-search-close aria-label={search.close_label}>
              <Icon name="close" size={20} />
            </button>
          </form>
        </div>
      </div>
      <LanguageSwitcher lang={lang} pathname={pathname} dict={dict} />
      <button
        class="header__toggle"
        type="button"
        data-drawer-toggle
        data-label-open={t.menu_open}
        data-label-close={t.menu_close}
        aria-expanded="false"
        aria-label={t.menu_open}
        aria-controls="mobile-drawer"
      >
        <Icon name="menu" />
      </button>
    </div>
  </div>

  <div class="drawer" id="mobile-drawer" data-drawer aria-hidden="true">
    <div class="drawer__backdrop" data-drawer-backdrop></div>
    <div class="drawer__panel">
      <div class="drawer__head">
        <span class="drawer__title">{t.footer.brand}</span>
        <button class="drawer__close" type="button" data-drawer-toggle aria-label={t.menu_close}>
          <Icon name="close" />
        </button>
      </div>
      <form class="drawer__search" action={getSearchPath(lang)} method="get" role="search">
        <input type="search" name="q" placeholder={search.placeholder} aria-label={search.aria_label} />
        <button type="submit" aria-label={search.submit}>
          <Icon name="search" size={20} />
        </button>
      </form>
      <nav class="drawer__nav" aria-label={t.nav.aria_label}>
        <ul>
          {navItems.map((item) => (
            <li>
              <a class:list={{ 'is-active': isActive(item.href) }} href={item.href} data-drawer-close>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="drawer__lang">
        <LanguageSwitcher lang={lang} pathname={pathname} dict={dict} />
      </div>
    </div>
  </div>
</header>

<script>
  import { initHeader } from '../../scripts/header-drawer';
  initHeader();
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-white);
    transition: box-shadow var(--duration-base) var(--easing);
  }

  .header.is-scrolled {
    box-shadow: var(--shadow-sm);
  }

  .header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    height: 56px;
  }

  @media (min-width: 1024px) {
    .header__bar {
      height: 72px;
    }
  }

  .header__logo {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .header__logo-img {
    display: block;
    width: auto;
    height: 28px;
  }

  @media (min-width: 1024px) {
    .header__logo-img {
      height: 36px;
    }
  }

  .header__nav {
    display: none;
  }

  @media (min-width: 1024px) {
    .header__nav {
      display: block;
    }

    .header__nav-list {
      display: flex;
      gap: var(--space-lg);
    }

    .header__nav-link {
      position: relative;
      display: inline-flex;
      align-items: center;
      height: 72px;
      font-size: var(--text-body);
      font-weight: var(--weight-medium);
      color: var(--color-neutral-700);
    }

    .header__nav-link:hover {
      color: var(--color-primary-600);
    }

    /* 悬停指示条：2px 青下滑入（150ms） */
    .header__nav-link::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 2px;
      background: var(--color-accent-500);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform var(--duration-fast) var(--easing);
    }

    .header__nav-link:hover::after,
    .header__nav-link.is-active::after {
      transform: scaleX(1);
    }

    .header__nav-link.is-active {
      color: var(--color-primary-600);
    }

    /* 下拉菜单（design-spec §6.2：白底卡片 shadow-md 单列） */
    .header__nav-list .has-dropdown {
      position: relative;
    }

    .header__nav-list .has-dropdown > a {
      gap: var(--space-3xs);
    }

    .header__dropdown {
      position: absolute;
      top: 100%;
      left: 50%;
      transform: translateX(-50%);
      min-width: 240px;
      max-height: 70vh;
      overflow-y: auto;
      padding: var(--space-2xs);
      background: var(--color-white);
      border: var(--border-default);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-md);
      opacity: 0;
      visibility: hidden;
      transition: opacity var(--duration-base) var(--easing),
        visibility var(--duration-base) var(--easing);
    }

    .header__nav-list .has-dropdown:hover .header__dropdown,
    .header__nav-list .has-dropdown:focus-within .header__dropdown {
      opacity: 1;
      visibility: visible;
    }

    .header__dropdown a {
      display: flex;
      align-items: center;
      min-height: 44px;
      padding: var(--space-xs) var(--space-sm);
      border-radius: var(--radius-sm);
      font-size: var(--text-body);
      color: var(--color-neutral-700);
    }

    .header__dropdown a:hover {
      background: var(--color-primary-50);
      color: var(--color-primary-600);
    }
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  /* ── 站内搜索（page-structure §0.3：图标 → 滑出搜索条 64px） ── */
  .search {
    position: relative;
  }

  .search__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    color: var(--color-neutral-700);
  }

  .search__toggle:hover {
    background: var(--color-primary-50);
    color: var(--color-primary-600);
  }

  .search__bar {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: min(560px, 85vw);
    padding: var(--space-sm);
    background: var(--color-white);
    border: var(--border-default);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    z-index: var(--z-dropdown);
  }

  .search__form {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .search__input {
    flex: 1;
    height: 48px;
    padding: var(--space-xs) var(--space-sm);
    border: var(--border-default);
    border-radius: var(--radius-sm);
    font-size: 16px;
    color: var(--color-neutral-900);
    background: var(--color-white);
  }

  .search__input::placeholder {
    color: var(--color-neutral-500);
  }

  .search__input:focus {
    outline: none;
    border-color: var(--color-primary-600);
    box-shadow: 0 0 0 3px var(--color-primary-100);
  }

  .search__submit,
  .search__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: var(--radius-sm);
    color: var(--color-neutral-700);
  }

  .search__submit:hover,
  .search__close:hover {
    background: var(--color-primary-50);
    color: var(--color-primary-600);
  }

  /* 移动抽屉内搜索框（page-structure §0.3） */
  .drawer__search {
    display: flex;
    gap: var(--space-2xs);
    padding: var(--space-md);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .drawer__search input {
    flex: 1;
    height: 44px;
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.08);
    color: var(--color-white);
    font-size: 16px;
  }

  .drawer__search input::placeholder {
    color: rgba(255, 255, 255, 0.6);
  }

  .drawer__search input:focus {
    outline: none;
    border-color: var(--color-accent-500);
  }

  .drawer__search button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background: var(--color-accent-500);
    color: var(--color-primary-900);
  }

  .header__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-neutral-900);
    cursor: pointer;
  }

  .header__toggle:hover {
    background: var(--color-primary-50);
  }

  @media (min-width: 1024px) {
    .header__toggle {
      display: none;
    }
  }

  /* ── 移动抽屉（design-spec §6.2：深底右滑入 250ms） ────────────── */
  .drawer {
    position: fixed;
    inset: 0;
    z-index: 200;
    visibility: hidden;
    pointer-events: none;
  }

  .drawer.is-open {
    visibility: visible;
    pointer-events: auto;
  }

  .drawer__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(11, 43, 82, 0.5);
    opacity: 0;
    transition: opacity var(--duration-base) var(--easing);
  }

  .drawer.is-open .drawer__backdrop {
    opacity: 1;
  }

  .drawer__panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    width: min(320px, 85vw);
    background: var(--color-primary-900);
    color: var(--color-white);
    transform: translateX(100%);
    transition: transform var(--duration-base) var(--easing);
  }

  .drawer.is-open .drawer__panel {
    transform: translateX(0);
  }

  .drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-md);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .drawer__title {
    font-size: var(--text-body-lg);
    font-weight: var(--weight-bold);
  }

  .drawer__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-white);
    cursor: pointer;
  }

  .drawer__close:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .drawer__nav {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-md);
  }

  .drawer__nav a {
    display: block;
    padding: var(--space-sm) 0;
    font-size: var(--text-body-lg);
    color: rgba(255, 255, 255, 0.85);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .drawer__nav a:hover,
  .drawer__nav a.is-active {
    color: var(--color-white);
  }

  .drawer__lang {
    padding: var(--space-md);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .drawer__lang .lang-switcher {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.12);
  }

  .drawer__lang .lang-switcher__link {
    color: var(--color-white);
  }

  .drawer__lang .lang-switcher__link:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .drawer__lang .lang-switcher__sep {
    color: rgba(255, 255, 255, 0.4);
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer__panel,
    .drawer__backdrop {
      transition: none;
    }
  }
</style>