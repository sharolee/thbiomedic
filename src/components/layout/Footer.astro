---
import type { FooterProps } from '../../types/components';
import Icon from '../ui/Icon.astro';
import { getHomePath, getAboutPath, getDownloadsPath, getVideosPath, getContactPath, getCategoryPath } from '../../utils/url';
import { localAsset, assetUrl } from '../../utils/assets';
import { getCategories, getContact } from '../../utils/content';

type Props = FooterProps;

// 页脚（design-spec §6.5）：深底 #0B2B52，桌面五列栅格 / 移动单列堆叠
// 对齐原站页脚结构：关于我们 / 产品中心（10 一级分类）/ 资源 / 联系我们 +
// 公众号二维码（原站真实素材，assets.ts 直引）+ 社交链接 + ICP / 建站商
const { lang, dict } = Astro.props;
const t = dict.common;
const year = new Date().getFullYear();
const categories = getCategories(lang);
const contact = getContact(lang);
const aboutPath = getAboutPath(lang);

const columns = [
  {
    title: t.footer.column_about,
    links: [
      { href: aboutPath, label: t.nav.about },
      { href: `${aboutPath}#certificates`, label: t.footer.honors },
      { href: `/${lang}/news/`, label: t.nav.news },
    ],
  },
  {
    title: t.footer.column_products,
    links: categories.map((c) => ({ href: getCategoryPath(c.slug, lang), label: c.name })),
  },
  {
    title: t.footer.column_resources,
    links: [
      { href: getDownloadsPath(lang), label: t.nav.resources_downloads },
      { href: getVideosPath(lang), label: t.nav.resources_videos },
    ],
  },
  {
    title: t.footer.column_contact,
    links: [
      { href: getContactPath(lang), label: t.nav.contact },
    ],
  },
];
---

<footer class="footer">
  <div class="footer__inner u-container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a class="footer__logo" href={getHomePath(lang)}>
          <img
            class="footer__logo-img"
            src={localAsset('logo')}
            alt={t.footer.brand}
            width={188}
            height={54}
          />
        </a>
        <p class="footer__tagline">{t.footer.tagline}</p>
        {contact && contact.wechatQr && (
          <div class="footer__qr">
            <div class="footer__qr-img">
              <img
                src={assetUrl(contact.wechatQr.src)}
                alt={contact.wechatQr.alt}
                loading="lazy"
                width={80}
                height={80}
                onerror="this.remove()"
              />
            </div>
            <span class="footer__qr-label">{t.footer.qr_label}</span>
          </div>
        )}
        {contact && contact.social && (contact.social.linkedin || contact.social.facebook) && (
          <div class="footer__social">
            {contact.social.linkedin && (
              <a
                class="footer__social-link"
                href={contact.social.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn"
              >
                <Icon name="linkedin" size={20} />
              </a>
            )}
            {contact.social.facebook && (
              <a
                class="footer__social-link"
                href={contact.social.facebook}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Facebook"
              >
                <Icon name="facebook" size={20} />
              </a>
            )}
          </div>
        )}
      </div>

      {columns.map((col) => (
        <nav class="footer__col" aria-label={col.title}>
          <h3 class="footer__col-title">{col.title}</h3>
          <ul>
            {col.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="footer__bottom">
      <p class="footer__copyright">{t.footer.copyright.replace('{year}', String(year))}</p>
      <div class="footer__bottom-links">
        <a class="footer__icp" href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">
          {t.footer.icp}
        </a>
        <span class="footer__built">{t.footer.built_by}</span>
        <a class="footer__built-link" href="http://www.wanhu.com.cn" target="_blank" rel="noopener noreferrer">
          Wanhu
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-primary-900);
    color: var(--color-neutral-300);
    font-size: var(--text-small);
  }

  .footer__inner {
    padding-block: var(--space-2xl) var(--space-lg);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 1024px) {
    .footer__grid {
      grid-template-columns: 2fr 1fr 1.5fr 1fr 1fr;
      gap: var(--space-md);
    }
  }

  .footer__logo {
    display: inline-block;
  }

  .footer__logo-img {
    display: block;
    width: auto;
    height: 32px;
  }

  .footer__tagline {
    margin-top: var(--space-2xs);
    color: var(--color-neutral-500);
    max-width: 34em;
  }

  /* 公众号二维码（design-spec §6.5：96×96 白底 padding 8px 圆角 8px） */
  .footer__qr {
    display: grid;
    justify-items: center;
    gap: var(--space-2xs);
    width: max-content;
    margin-top: var(--space-md);
  }

  .footer__qr-img {
    display: grid;
    place-items: center;
    width: 96px;
    height: 96px;
    padding: 8px;
    border-radius: var(--radius-md);
    background: var(--color-white);
  }

  .footer__qr-img img {
    width: 80px;
    height: 80px;
    object-fit: contain;
  }

  .footer__qr-label {
    font-size: var(--text-caption);
    color: var(--color-neutral-500);
  }

  .footer__social {
    display: flex;
    gap: var(--space-2xs);
    margin-top: var(--space-md);
  }

  .footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--color-neutral-300);
  }

  .footer__social-link:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--color-white);
  }

  .footer__col-title {
    margin-bottom: var(--space-sm);
    font-size: var(--text-body);
    font-weight: var(--weight-medium);
    color: var(--color-white);
  }

  .footer__col li + li {
    margin-top: var(--space-2xs);
  }

  .footer__col a {
    color: var(--color-neutral-300);
  }

  .footer__col a:hover {
    color: var(--color-white);
    text-decoration: underline;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs);
    margin-top: var(--space-xl);
    padding-top: var(--space-sm);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    font-size: var(--text-caption);
    color: var(--color-neutral-500);
  }

  .footer__copyright {
    max-width: none;
  }

  .footer__bottom-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
  }

  .footer__icp,
  .footer__built-link {
    color: var(--color-neutral-500);
  }

  .footer__icp:hover,
  .footer__built-link:hover {
    color: var(--color-white);
    text-decoration: underline;
  }
</style>
