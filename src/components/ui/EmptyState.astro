---
import type { EmptyStateProps } from '../../types/components';
import Icon from './Icon.astro';

type Props = EmptyStateProps;

// 空态面板（design-spec §6.6）：浅灰插图区 48px 线性图标 + 标题 + 说明 + 可选行动
const { title, body, icon = 'alert', ...attrs } = Astro.props;
---

<div class="empty-state" {...attrs}>
  <div class="empty-state__icon"><Icon name={icon} size={40} /></div>
  <h3 class="empty-state__title">{title}</h3>
  {body && <p class="empty-state__body">{body}</p>}
  <div class="empty-state__actions"><slot /></div>
</div>

<style>
  .empty-state {
    display: grid;
    justify-items: center;
    gap: var(--space-sm);
    padding: var(--space-2xl) var(--space-md);
    text-align: center;
  }

  .empty-state__icon {
    display: grid;
    place-items: center;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--color-neutral-100);
    color: var(--color-neutral-500);
  }

  .empty-state__title {
    font-size: var(--text-h4);
    color: var(--color-neutral-900);
  }

  .empty-state__body {
    font-size: var(--text-body);
    color: var(--color-neutral-500);
    max-width: var(--measure-zh);
  }

  .empty-state__actions {
    margin-top: var(--space-2xs);
  }
</style>
