---
import type { ContactFormProps } from '../../types/components';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

type Props = ContactFormProps;

// 在线留言表单（design-spec §6.4 / ADR-005）
// 字段：称呼 / 公司* / 邮箱* / 名* / 姓* / 手机 / 内容；隐藏字段记录来源 slug
// 交互岛屿（client:load，页面使用处标记）：客户端校验 + 成功/错误面板
// ADR-005：校验通过后拼装 mailto: 结构化邮件唤起邮件客户端；
// 无 JS 降级：form action=mailto: + noscript 备用邮件链接
const { dict, sourceSlug, email } = Astro.props;
const t = dict.common.form;
const mailtoHref = email ? `mailto:${email}` : undefined;
---

<div
  class="contact-form"
  data-contact-form
  data-email-target={email ?? ''}
  data-mailto-subject={t.mailto_subject}
  data-label-salutation={t.salutation}
  data-label-company={t.company}
  data-label-email={t.email}
  data-label-first-name={t.first_name}
  data-label-last-name={t.last_name}
  data-label-phone={t.phone}
  data-label-message={t.message}
  data-label-source={t.source}
>
  <form
    class="contact-form__form"
    method="post"
    action={mailtoHref}
    novalidate
    data-contact-form-el
  >
    {sourceSlug && <input type="hidden" name="source" value={sourceSlug} />}

    <div class="contact-form__grid">
      <div class="form-group">
        <label class="form-label" for="cf-salutation">{t.salutation}</label>
        <input class="form-input" type="text" id="cf-salutation" name="salutation" autocomplete="honorific-prefix" />
      </div>

      <div class="form-group">
        <label class="form-label" for="cf-company">{t.company} <span class="req" aria-hidden="true">*</span></label>
        <input
          class="form-input"
          type="text"
          id="cf-company"
          name="company"
          required
          data-required
          autocomplete="organization"
        />
        <p class="form-error" data-error-for="cf-company" hidden>
          <Icon name="alert" size={16} />
          <span>{t.error_required}</span>
        </p>
      </div>

      <div class="form-group">
        <label class="form-label" for="cf-email">{t.email} <span class="req" aria-hidden="true">*</span></label>
        <input
          class="form-input"
          type="email"
          id="cf-email"
          name="email"
          required
          data-required
          data-email
          autocomplete="email"
        />
        <p class="form-error" data-error-for="cf-email" data-error-email={t.error_email} hidden>
          <Icon name="alert" size={16} />
          <span>{t.error_required}</span>
        </p>
      </div>

      <div class="form-group">
        <label class="form-label" for="cf-first-name">{t.first_name} <span class="req" aria-hidden="true">*</span></label>
        <input
          class="form-input"
          type="text"
          id="cf-first-name"
          name="first_name"
          required
          data-required
          autocomplete="given-name"
        />
        <p class="form-error" data-error-for="cf-first-name" hidden>
          <Icon name="alert" size={16} />
          <span>{t.error_required}</span>
        </p>
      </div>

      <div class="form-group">
        <label class="form-label" for="cf-last-name">{t.last_name} <span class="req" aria-hidden="true">*</span></label>
        <input
          class="form-input"
          type="text"
          id="cf-last-name"
          name="last_name"
          required
          data-required
          autocomplete="family-name"
        />
        <p class="form-error" data-error-for="cf-last-name" hidden>
          <Icon name="alert" size={16} />
          <span>{t.error_required}</span>
        </p>
      </div>

      <div class="form-group">
        <label class="form-label" for="cf-phone">{t.phone}</label>
        <input class="form-input" type="tel" id="cf-phone" name="phone" autocomplete="tel" />
      </div>

      <div class="form-group contact-form__full">
        <label class="form-label" for="cf-message">{t.message}</label>
        <textarea class="form-input form-textarea" id="cf-message" name="message"></textarea>
      </div>
    </div>

    <p class="form-note">{t.note}</p>

    <div class="contact-form__actions">
      <Button type="submit" variant="primary" class="contact-form__submit">{t.submit}</Button>
    </div>

    {mailtoHref && (
      <noscript>
        <p class="form-note">{t.no_js_hint}</p>
        <a class="contact-form__mailto-link" href={mailtoHref}>{t.mailto_label}</a>
      </noscript>
    )}
  </form>

  <div class="contact-form__success" data-form-success hidden>
    <div class="contact-form__success-icon"><Icon name="check" size={40} /></div>
    <h3 class="contact-form__success-title">{t.success_title}</h3>
    <p class="contact-form__success-body">{t.success_body}</p>
    {mailtoHref && (
      <a class="contact-form__mailto-link" href={mailtoHref}>{t.mailto_label}</a>
    )}
  </div>

  <div class="contact-form__error-bar" data-form-error-bar hidden>
    <Icon name="alert" size={20} />
    <span>{t.error_submit}</span>
  </div>
</div>

<script>
  import { initContactForm } from '../../scripts/form-handler';
  initContactForm();
</script>

<style>
  .contact-form__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 var(--space-md);
  }

  @media (min-width: 768px) {
    .contact-form__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .contact-form__full {
      grid-column: 1 / -1;
    }
  }

  .form-note {
    font-size: var(--text-small);
    color: var(--color-neutral-500);
    margin-bottom: var(--space-md);
  }

  /* 字段级错误（design-spec §6.4：边框 #C53030 + 下方 14px 错误文案） */
  .form-error {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    margin-top: var(--space-2xs);
    font-size: 14px;
    color: var(--color-error-600);
  }

  .form-input[aria-invalid='true'] {
    border-color: var(--color-error-600);
  }

  .contact-form__actions {
    margin-top: var(--space-sm);
  }

  .contact-form__mailto-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-top: var(--space-sm);
    color: var(--color-primary-600);
    font-weight: var(--weight-medium);
  }

  .contact-form__mailto-link:hover {
    text-decoration: underline;
  }

  .contact-form__success {
    display: grid;
    justify-items: center;
    gap: var(--space-sm);
    padding: var(--space-xl) var(--space-md);
    border-radius: var(--radius-md);
    background: var(--color-success-50);
    text-align: center;
  }

  .contact-form__success-icon {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--color-success-600);
    color: var(--color-white);
  }

  .contact-form__success-title {
    font-size: var(--text-h4);
    color: var(--color-neutral-900);
  }

  .contact-form__success-body {
    font-size: var(--text-body);
    color: var(--color-neutral-700);
  }

  /* 表单顶部错误条（design-spec §6.4 / page-structure §0.4） */
  .contact-form__error-bar {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-top: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-sm);
    background: var(--color-error-50);
    color: var(--color-error-600);
    font-size: var(--text-small);
  }

  /* 校验错误时输入框边框（design-spec §6.4） */
  .contact-form__form :global(.form-input.is-invalid) {
    border-color: var(--color-error-600);
  }

  .contact-form__form :global(.form-input.is-invalid:focus) {
    box-shadow: 0 0 0 3px var(--color-error-50);
  }
</style>
