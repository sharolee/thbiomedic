  check: 'M4 12.5l5.5 5.5L20 6.5',
  phone: 'M4 6a2 2 0 0 1 2-2h2l1.5 4.5-2 1.5a12 12 0 0 0 6 6l1.5-2L20 15v2a2 2 0 0 1-2 2A14 14 0 0 1 4 6z',
  mail: 'M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm17 1l-9 7-9-7',
  'map-pin': 'M12 21s-7-5.1-7-11a7 7 0 0 1 14 0c0 5.9-7 11-7 11zm0-8.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z',
