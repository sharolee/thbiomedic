  download: 'M12 4v12m0 0l-5-5m5 5l5-5M5 20h14',
  file: 'M6 3h8l4 4v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zm8 0v5h5',
  image: 'M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm15 4.5l-4 4-3-3-5 5.5M8.5 9a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z',
  external: 'M14 4h6v6M20 4l-9 9M10 6H5a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-5',
  linkedin: 'M4 4h16a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1zm4 7v6m0-9.5v.5M8 11h.01M12 11v6m0-2.5c0-1.5 1-2.5 2.5-2.5s2.5 1 2.5 2.5V17',
