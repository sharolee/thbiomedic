# 环境变量示例（复制为 .env 后按需修改）
# 参见 docs/architecture.md §6

# 生产站点根域名（用于 sitemap、hreflang、canonical 绝对 URL）
PUBLIC_SITE_URL=https://www.thbiomedic.com

# 默认语言（hreflang x-default 指向，见 ADR-002 §3.4）
PUBLIC_DEFAULT_LANG=en

# 构建时间戳（自动注入页面注释，便于缓存刷新核对）
# BUILD_TIMESTAMP=auto

# API 地址（ADR-005：留言表单已采用 mailto: 方案，收件邮箱见 contact.json，
# 无需后端端点；此处仅作 serverless 升级预留，见 ADR-005 §2.4）
# PUBLIC_API_URL=http://localhost:3000
